generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums -------------------------------------------------------------------

enum SystemRole {
  USER
  SUPPORT
  MASTER

  @@map("system_role")
}

enum PlanType {
  GRACE
  TRIAL

  @@map("plan_type")
}

enum OtpPurpose {
  SIGN_UP
  SIGN_IN

  @@map("otp_purpose")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED

  @@map("invitation_status")
}

enum LocationType {
  CLASSROOM
  LAB
  AUDITORIUM
  SPORTS_FACILITY
  VIRTUAL

  @@map("location_type")
}

enum TermStatus {
  PLANNING
  ADJUSTMENTS
  STARTED
  FINISHED
  CANCELLED

  @@map("term_status")
}

enum ProjectStatus {
  DRAFT
  PUBLISHED

  @@map("project_status")
}

// --- Identity ----------------------------------------------------------------

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String
  systemRole      SystemRole @default(USER) @map("system_role")
  isActive        Boolean    @default(true) @map("is_active")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscription          Subscription?
  assignedSubscriptions Subscription[]   @relation("SubscriptionAssignedBy")
  otpCodes              OtpCode[]
  refreshTokens         RefreshToken[]
  ownedOrganizations    Organization[]
  unitMemberships       UnitMember[]
  receivedInvitations   UnitInvitation[] @relation("InvitationInvitee")
  sentInvitations       UnitInvitation[] @relation("InvitationInviter")
  coordinatedCourses    Course[]
  createdTerms          Term[]
  createdProjects       Project[]
  teacherProfiles       Teacher[]

  @@map("users")
}

model Subscription {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  plan         PlanType
  startsAt     DateTime  @default(now()) @map("starts_at") @db.Timestamptz(3)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  assignedById String?   @map("assigned_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("SubscriptionAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// --- Tenancy -----------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String?
  ownerId   String   @map("owner_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  units    Unit[]
  teachers Teacher[]

  @@index([ownerId])
  @@map("organizations")
}

model Unit {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  address        String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members      UnitMember[]
  invitations  UnitInvitation[]
  courses      Course[]
  locations    Location[]
  terms        Term[]
  timeTables   TimeTable[]
  projects     Project[]

  @@unique([organizationId, slug])
  @@map("units")
}

model UnitMember {
  id        String   @id @default(cuid())
  unitId    String   @map("unit_id")
  userId    String   @map("user_id")
  isManager Boolean  @default(false) @map("is_manager")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([unitId, userId])
  @@index([userId])
  @@map("unit_members")
}

model UnitInvitation {
  id          String           @id @default(cuid())
  unitId      String           @map("unit_id")
  inviteeId   String           @map("invitee_id")
  invitedById String           @map("invited_by_id")
  isManager   Boolean          @default(false) @map("is_manager")
  isTeacher   Boolean          @default(false) @map("is_teacher")
  status      InvitationStatus @default(PENDING)
  tokenHash   String           @unique @map("token_hash")
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(3)
  respondedAt DateTime?        @map("responded_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit      Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  invitee   User @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Restrict)
  invitedBy User @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([unitId, status])
  @@index([inviteeId, status])
  @@map("unit_invitations")
}

/// The organization's teacher. Without a user it is a vacancy ("Professor de Matemática 1"); the
/// user is set only at creation and never changes.
model Teacher {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  name           String
  area           String?
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  offerings    Offering[]

  @@unique([organizationId, name])
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("teachers")
}

// --- Academic catalog --------------------------------------------------------

model Course {
  id            String   @id @default(cuid())
  unitId        String   @map("unit_id")
  name          String
  code          String?
  coordinatorId String?  @map("coordinator_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  coordinator User?        @relation(fields: [coordinatorId], references: [id], onDelete: SetNull)
  curricula   Curriculum[]

  @@unique([unitId, code])
  @@index([coordinatorId])
  @@map("courses")
}

model Curriculum {
  id          String   @id @default(cuid())
  courseId    String   @map("course_id")
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  subjects Subject[]
  projects Project[]

  @@unique([courseId, code])
  @@map("curricula")
}

model Subject {
  id           String   @id @default(cuid())
  curriculumId String   @map("curriculum_id")
  name         String
  code         String
  workload     Int
  /// Organizational only: groups and sorts subjects within the curriculum (101, 202…).
  level        Int      @default(1)
  color        String   @default("#000000") @db.Char(7)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  offerings  Offering[]

  @@unique([curriculumId, code])
  @@index([curriculumId, level])
  @@map("subjects")
}

// --- Space and time ----------------------------------------------------------

model Location {
  id        String       @id @default(cuid())
  unitId    String       @map("unit_id")
  name      String
  type      LocationType
  capacity  Int?
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit       Unit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  boardSlots BoardSlot[]

  @@unique([unitId, name])
  @@map("locations")
}

model Term {
  id          String     @id @default(cuid())
  unitId      String     @map("unit_id")
  name        String
  startDate   DateTime   @map("start_date") @db.Date
  endDate     DateTime   @map("end_date") @db.Date
  status      TermStatus @default(PLANNING)
  createdById String     @map("created_by_id")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  projects  Project[]

  @@unique([unitId, name])
  @@map("terms")
}

model TimeTable {
  id        String   @id @default(cuid())
  unitId    String   @map("unit_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit   Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  slots  TimeSlot[]
  boards Board[]

  @@unique([unitId, name])
  @@map("time_tables")
}

/// Minutes since midnight, half-open interval [startTime, endTime).
model TimeSlot {
  id          String   @id @default(cuid())
  timeTableId String   @map("time_table_id")
  name        String
  startTime   Int      @map("start_time")
  endTime     Int      @map("end_time")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  timeTable  TimeTable   @relation(fields: [timeTableId], references: [id], onDelete: Cascade)
  boardSlots BoardSlot[]

  @@unique([timeTableId, name])
  @@map("time_slots")
}

// --- Scheduling --------------------------------------------------------------

model Project {
  id           String        @id @default(cuid())
  unitId       String        @map("unit_id")
  termId       String        @map("term_id")
  curriculumId String        @map("curriculum_id")
  name         String
  status       ProjectStatus @default(DRAFT)
  workingDays  Int           @default(5) @map("working_days")
  createdById  String        @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  term       Term       @relation(fields: [termId], references: [id], onDelete: Restrict)
  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  createdBy  User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  offerings  Offering[]
  boards     Board[]

  @@unique([termId, name])
  @@index([unitId])
  @@index([termId, status])
  @@map("projects")
}

model Offering {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  subjectId String   @map("subject_id")
  teacherId String?  @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher    Teacher?    @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  boardSlots BoardSlot[]

  @@unique([projectId, subjectId])
  @@index([teacherId])
  @@map("offerings")
}

/// One schedule grid of the project, usually one per course semester; name holds the class name.
model Board {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  timeTableId String   @map("time_table_id")
  name        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeTable TimeTable   @relation(fields: [timeTableId], references: [id], onDelete: Restrict)
  slots     BoardSlot[]

  @@unique([projectId, name])
  @@index([timeTableId])
  @@map("boards")
}

/// weekday: 1 = Monday … 6 = Saturday.
model BoardSlot {
  id         String   @id @default(cuid())
  boardId    String   @map("board_id")
  timeSlotId String   @map("time_slot_id")
  weekday    Int
  offeringId String?  @map("offering_id")
  locationId String?  @map("location_id")
  isBlocked  Boolean  @default(false) @map("is_blocked")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  timeSlot TimeSlot  @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  offering Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([boardId, timeSlotId, weekday])
  @@index([offeringId])
  @@index([locationId])
  @@map("board_slots")
}
