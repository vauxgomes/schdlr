# ---------------------------------------------------------------------------
# Test environment
# ---------------------------------------------------------------------------
# Versionado de propósito: não há segredo aqui, e a suíte precisa apontar para
# o mesmo banco em qualquer máquina. O banco vive no container do
# docker-compose, separado do de desenvolvimento apenas pelo nome.

NODE_ENV=test
PORT=3002
DATABASE_URL="postgresql://schdlr:schdlr@localhost:5434/schdlr_test?schema=public"
CORS_ORIGIN=http://localhost:3000
JWT_SECRET="test-secret-not-used-anywhere-else-0123456789"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
UNIT_INVITE_TTL_DAYS=7
