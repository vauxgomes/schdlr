# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Credentials match the docker-compose.yml at the repo root.

DATABASE_URL="postgresql://schdlr:schdlr@localhost:5434/schdlr?schema=public"

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Origem do app web. Com `credentials: true` o navegador exige uma origem
# explícita — '*' não vale.

CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# JWT_SECRET precisa de 32 caracteres ou mais; em produção use um valor gerado
# por máquina e nunca o mesmo de outro ambiente.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

JWT_SECRET=""
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
UNIT_INVITE_TTL_DAYS=7

# Base dos links enviados por e-mail — onde o app web responde.
WEB_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
# Bloco inteiro é opcional. Sem SMTP_HOST a app sobe normalmente e o envio
# apenas registra no log o que teria mandado — que é o modo de desenvolvimento.

# SMTP_HOST=
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="schdlr <no-reply@schdlr.local>"
