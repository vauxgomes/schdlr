# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Credenciais do docker-compose.yml da raiz; a senha é o POSTGRES_PASSWORD do
# .env da raiz (padrão: schdlr).

DATABASE_URL="postgresql://schdlr:schdlr@localhost:5434/schdlr?schema=public"

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Origem do app web. Com `credentials: true` o navegador exige uma origem
# explícita — '*' não vale.

CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# JWT_SECRET precisa de 32 caracteres ou mais; em produção use um valor gerado
# por máquina e nunca o mesmo de outro ambiente.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

JWT_SECRET=""
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
UNIT_INVITE_TTL_DAYS=7

# Base dos links enviados por e-mail — onde o app web responde.
WEB_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
# Lidas só por `pnpm db:seed`, nunca pela API. O root é sempre semeado e
# ROOT_PASSWORD não tem padrão: sem ela a seed para antes de tocar no banco.
# SET_FIRST_TENANT=true cria o tenant de teste (Root-Test-Organization), com
# admin@, manager@, coordinator@ e teacher@schdlr.dev — senha igual ao e-mail.
# A seed não sobrescreve: trocar estes valores depois de semeado não muda nada.

ROOT_EMAIL=root@schdlr.dev
ROOT_PASSWORD=""
SET_FIRST_TENANT=false

# ---------------------------------------------------------------------------
# Auditoria
# ---------------------------------------------------------------------------
# Diretório onde a trilha é gravada, um arquivo por dia (audit-AAAA-MM-DD.log).
# Opcional: ausente, nada é escrito e a app sobe igual. Relativo ao diretório
# de onde a API roda (apps/api).

# AUDIT_LOG_PATH=./logs/audit

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
# Bloco inteiro é opcional. Sem SMTP_HOST a app sobe normalmente e o envio
# apenas registra no log o que teria mandado — que é o modo de desenvolvimento.

# SMTP_HOST=
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="schdlr <no-reply@schdlr.local>"
