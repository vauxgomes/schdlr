# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Aponta para o Postgres do container (`docker compose up -d db`), na porta
# 5434. Usuário, banco e credencial são os padrões do docker-compose.yml da
# raiz (schdlr); se o .env da raiz mudar algum deles, ajuste aqui também.

DATABASE_URL="postgresql://schdlr:schdlr@localhost:5434/schdlr?schema=public"

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Origem do app web. Com `credentials: true` o navegador exige uma origem
# explícita — '*' não vale.

CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# JWT_SECRET precisa de 32 caracteres ou mais; em produção use um valor gerado
# por máquina e nunca o mesmo de outro ambiente.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

JWT_SECRET=""
JWT_EXPIRES_IN=15m
# Validade da sessão: o refresh token vai num cookie httpOnly e gira a cada uso.
REFRESH_TOKEN_TTL_DAYS=7

# Ainda não lido pela API — entra no schema do env com a spec que usar.
UNIT_INVITE_TTL_DAYS=7

# Ainda não lido pela API — entra no schema do env com a spec que usar.
# Base dos links enviados por e-mail — onde o app web responde.
WEB_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
# Lidas só por `pnpm db:seed`, nunca pela API. O root é sempre semeado como o
# único MASTER: a seed para se já houver outro MASTER, ou se ROOT_EMAIL já for
# de um usuário comum.
# SET_FIRST_TENANT=true cria o tenant de teste (Root-Test-Organization), com
# admin@, manager@, coordinator@ e teacher@schdlr.dev. O acesso dos usuários
# semeados é por OTP; no ambiente local, use `pnpm otp <email>`. O tenant não é
# semeado em NODE_ENV=production.
# A seed não sobrescreve: trocar estes valores depois de semeado não muda nada.

ROOT_EMAIL=vaux.gomes@ifce.edu.br
SET_FIRST_TENANT=false

# ---------------------------------------------------------------------------
# Auditoria
# ---------------------------------------------------------------------------
# Ainda não lido pela API — entra no schema do env com a spec que usar.
# Diretório onde a trilha é gravada, um arquivo por dia (audit-AAAA-MM-DD.log).
# Opcional: ausente, nada é escrito e a app sobe igual. Relativo ao diretório
# de onde a API roda (apps/api).

# AUDIT_LOG_PATH=./logs/audit

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
# Desligado no ambiente local: nenhum e-mail sai, e o log da API registra só
# destinatário e assunto (o corpo, com o código do OTP, nunca vai para o log).
# Com MAIL_ENABLED=true o envio é pelo Gmail, e MAIL_USER e MAIL_PASS (senha de
# app do Google) passam a ser obrigatórias. São credenciais reais: ficam só no .env.

MAIL_ENABLED=false
MAIL_FROM=noreply@schdlr.ifce.edu.br
MAIL_USER=
MAIL_PASS=
